{
  "name": "positionguard-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server over PositionGuard presence. Holds one agent-type API key; answers only what the member agreed to share, and says unknown when they didn't.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "positionguard-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "capture": "tsx scripts/capture-fixtures.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
